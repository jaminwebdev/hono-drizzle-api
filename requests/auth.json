{
  "info": {
    "name": "Learning API authentication",
    "description": "Import into Requestly using its Postman collection importer. Fill in each blank password locally. Register first, then log in with the same credentials. Requestly keeps the session cookie in its cookie jar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000", "type": "string" },
    { "key": "email", "value": "learner@example.test", "type": "string" }
  ],
  "item": [
    {
      "name": "Register a user",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Origin", "value": "{{baseUrl}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "Log in",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Origin", "value": "{{baseUrl}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    }
  ]
}
