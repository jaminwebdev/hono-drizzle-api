# Copy to .env.local and replace the example password before starting the API.
# For .env.production, use APP_ENV=production and separate credentials.
APP_ENV=local

# Local API port.
API_PORT=3000

# The local API and Drizzle connect to the published PostgreSQL port.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# PostgreSQL container and API share these credentials.
POSTGRES_USER=finance
POSTGRES_DB=finance
# Quote passwords containing # or spaces. Bun expands $VARIABLE even in quotes.
# Escape a literal $NAME reference as \$NAME. A final $ needs no escape.
# Bun supplies the same parsed value to the API, Drizzle, and Compose.
POSTGRES_PASSWORD='replace-with-a-long-unique-password'
