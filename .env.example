# Copy to .env.local and replace the example password before starting the API.
# For .env.production, use APP_ENV=production and separate credentials.
APP_ENV=local

# API port, both inside Docker and on your computer.
API_PORT=3000

# Host port for an optional external database client.
# The API and Docker tooling always connect to db:5432 instead.
POSTGRES_PORT=5433

# PostgreSQL container and API share these credentials.
POSTGRES_USER=finance
POSTGRES_DB=finance
# Keep quotes around passwords containing # or spaces.
POSTGRES_PASSWORD='replace-with-a-long-unique-password'
