# Local template. Copy to .env.local and choose a unique database password.
# Keep real environment files out of Git and the Docker image.
APP_ENV=local

# Local API port.
API_PORT=3000

# Optional browser origins, comma-separated with no trailing slashes. Empty disables CORS.
# Example: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# The local API and Drizzle connect to the published PostgreSQL port.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# PostgreSQL container and API share these credentials.
POSTGRES_USER=finance
POSTGRES_DB=finance_tracker_local
# Quote passwords containing # or spaces. Bun expands $VARIABLE even in quotes.
# Escape a literal $NAME reference as \$NAME. A final $ needs no escape.
# Bun supplies the same parsed value to the API, Drizzle, and Compose.
POSTGRES_PASSWORD='replace-with-a-long-unique-password'

# For .env.test, use these settings with a separate password:
# APP_ENV=test
# API_PORT=3002
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5435
# POSTGRES_USER=finance_test
# POSTGRES_DB=finance_tracker_test

# For .env.production, use these settings with another separate password:
# APP_ENV=production
# API_PORT=3001
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5434
# POSTGRES_USER=finance_production
# POSTGRES_DB=finance_tracker_production
# Production Compose explicitly overrides the API's address to db:5432.
