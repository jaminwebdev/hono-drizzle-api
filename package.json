{
  "name": "hono-drizzle-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "bun --env-file=.env.local --watch src/server.ts local",
    "build": "bun build src/server.ts --target=bun --packages=external --outdir=dist --sourcemap=external",
    "start": "bun --no-env-file dist/server.js production",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint . --max-warnings 0",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "db:up": "bun --env-file=.env.local run docker compose -f compose.yaml up --detach --wait --wait-timeout 120 --remove-orphans",
    "db:down": "bun --env-file=.env.local run docker compose -f compose.yaml down --remove-orphans",
    "db:logs": "bun --env-file=.env.local run docker compose -f compose.yaml logs --follow db",
    "db:push": "bun --env-file=.env.local --bun run drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "bun --env-file=.env.local --bun run drizzle-kit studio --config=drizzle.config.ts",
    "test:integration": "bun --no-env-file scripts/test-integration.ts",
    "docker:build": "docker build --target runtime -t hono-drizzle-api ."
  },
  "dependencies": {
    "hono": "^4.12.9",
    "zod": "^4.0.0",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "drizzle-kit": "^0.31.0",
    "@types/pg": "^8.15.0",
    "@types/bun": "1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
