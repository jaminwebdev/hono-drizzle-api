{
  "name": "hono-drizzle-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts local file",
    "dev:container": "tsx watch src/server.ts local environment",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js production environment",
    "start:local": "node dist/server.js local file",
    "start:production:file": "node dist/server.js production file",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "docker:up": "sh scripts/docker.sh local up",
    "docker:down": "sh scripts/docker.sh local down",
    "docker:logs": "sh scripts/docker.sh local logs",
    "docker:check": "sh scripts/docker.sh local check",
    "docker:up:production": "sh scripts/docker.sh production up",
    "docker:down:production": "sh scripts/docker.sh production down",
    "docker:logs:production": "sh scripts/docker.sh production logs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "hono": "^4.12.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.0.0"
  }
}
