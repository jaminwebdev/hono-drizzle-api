{
  "name": "finance-tracker-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "bun --env-file=.env.local --watch src/server.ts",
    "build": "bun --no-env-file build src/server.ts --target=bun --outdir=dist",
    "typecheck": "bun --no-env-file run --bun tsc --noEmit",
    "lint": "bun --no-env-file run --bun eslint .",
    "check": "bun --no-env-file run typecheck && bun --no-env-file run lint && bun --no-env-file run build"
  },
  "dependencies": {
    "hono": "4.13.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
